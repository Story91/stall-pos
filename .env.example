# PayPal sandbox (Dashboard → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Dashboard → your app → Webhooks → Webhook ID (needed for signature verification)
PAYPAL_WEBHOOK_ID=
# Short-lived bearer token for the local @paypal/mcp server (scripts/get-sandbox-token.ps1)
PAYPAL_ACCESS_TOKEN=

# Sandbox test accounts (Testing Tools → Sandbox Accounts); used by seed + README for judges
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
SANDBOX_MERCHANT_EMAIL=

# AI
ANTHROPIC_API_KEY=
# or route through Vercel AI Gateway
AI_GATEWAY_API_KEY=

# App
# Database. Zero-install default: in-process Postgres (PGlite), data kept in ./.data/stall,
# migrated and seeded with the La Esquina demo on first start. Use pglite://memory for a throwaway db.
# For a real Postgres (Neon, local), use the standard URL instead:
#   DATABASE_URL=postgres://user:pass@host:5432/db
DATABASE_URL=pglite://./.data/stall
APP_URL=http://localhost:3000

# Offline test doubles (Playwright smoke). Honoured only when NODE_ENV is not production.
PAYPAL_MOCK=
PARSE_MOCK=
